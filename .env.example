# Copy this file to .env and replace example.com/path placeholders before production use.

# Shared runtime mode and logging
NODE_ENV=production
LOG_LEVEL=info

# Public browser configuration (embedded by Vite during the production build)
VITE_SERVER_URL=https://multiplayer.example.com

# Development web server configuration
DEV_WEB_HOST=127.0.0.1
DEV_WEB_PORT=5173
DEV_WEB_STRICT_PORT=true
VITE_FALLBACK_MULTIPLAYER_PORT=2567
DEV_ALLOW_ANY_ORIGIN=false
PREVIEW_WEB_HOST=0.0.0.0
PREVIEW_WEB_PORT=4173
VITE_BASE_PATH=/

# Multiplayer server listener and externally visible address
HOST=0.0.0.0
PORT=2567
PUBLIC_SERVER_URL=https://multiplayer.example.com
ALLOWED_ORIGINS=https://game.example.com

# Optional direct TLS. Leave both unset when HTTPS/WSS terminates at a trusted reverse proxy.
TLS_CERT_PATH=/absolute/path/to/fullchain.pem
TLS_KEY_PATH=/absolute/path/to/privkey.pem

# Connection, transport, request, and shutdown limits
MAX_CONNECTIONS=1000
MAX_MESSAGE_BYTES=16384
MAX_HTTP_BODY_BYTES=65536
MAX_MESSAGES_PER_SECOND=180
PING_INTERVAL_MS=5000
PING_MAX_RETRIES=3
SHUTDOWN_TIMEOUT_MS=10000

# Development-only simulated round-trip latency in milliseconds
COLYSEUS_LATENCY=0
