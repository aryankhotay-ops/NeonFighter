{
  "name": "neon-rivals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names web,server --prefix-colors cyan,magenta \"pnpm --filter @neon-rivals/web dev\" \"pnpm --filter @neon-rivals/server dev\"",
    "dev:web": "pnpm --filter @neon-rivals/web dev",
    "dev:server": "pnpm --filter @neon-rivals/server dev",
    "build": "pnpm --filter @neon-rivals/web build && pnpm --filter @neon-rivals/server build",
    "build:production": "pnpm build",
    "start:server": "node --env-file-if-exists=.env apps/server/dist/index.js",
    "start:web": "pnpm --filter @neon-rivals/web preview",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@neon-rivals/protocol": "workspace:*",
    "@neon-rivals/simulation": "workspace:*",
    "@neon-rivals/test-tools": "workspace:*",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
